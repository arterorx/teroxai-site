---
import { getCollection } from 'astro:content';
import { localePath, type Locale } from '../i18n/config';
import { formatDate } from '../lib/site';
import { slugOf } from '../lib/posts';

interface Props {
  lang: Locale;
  limit?: number;
}
const { lang, limit }: Props = Astro.props;
const all = (await getCollection('blog', (p) => p.data.lang === lang)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const posts = limit ? all.slice(0, limit) : all;
---

<ul class="pl">
  {
    posts.map((p) => {
      const iso = p.data.date.toISOString().slice(0, 10);
      return (
        <li class:list={['card', 'pl__item', { 'pl__item--cover': p.data.cover }]}>
          {p.data.cover && (
            <a class="pl__thumb" href={localePath(lang, `blog/${slugOf(p.id)}`)} tabindex="-1" aria-hidden="true">
              <img src={`/og/blog/${p.data.cover}.png`} alt="" width="1200" height="630" loading="lazy" />
            </a>
          )}
          <div class="pl__body">
            <time class="pl__date" datetime={iso}>{formatDate(iso, lang)}</time>
            <a class="pl__title" href={localePath(lang, `blog/${slugOf(p.id)}`)}>{p.data.title}</a>
            <p class="pl__desc">{p.data.description}</p>
          </div>
        </li>
      );
    })
  }
</ul>

<style>
  .pl {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1rem;
  }
  .pl__item {
    display: grid;
    gap: 0.35rem;
    transition: transform 0.2s ease;
  }
  .pl__item--cover {
    grid-template-columns: 220px 1fr;
    gap: 1.25rem;
    align-items: center;
  }
  .pl__thumb img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 10px;
  }
  .pl__body {
    display: grid;
    gap: 0.35rem;
  }
  @media (max-width: 640px) {
    .pl__item--cover {
      grid-template-columns: 1fr;
    }
  }
  .pl__item:hover {
    transform: translateY(-2px);
  }
  @media (prefers-reduced-motion: reduce) {
    .pl__item {
      transition: none;
    }
  }
  .pl__date {
    color: var(--ink-3);
    font-size: 0.8125rem;
  }
  .pl__title {
    font-weight: 650;
    font-size: 1.125rem;
    color: var(--ink);
    text-decoration: none;
  }
  .pl__title:hover {
    text-decoration: underline;
  }
  .pl__desc {
    margin: 0;
    color: var(--ink-2);
  }
</style>
