---
/* Apple's official badge artwork, fetched from Apple's marketing toolbox
   (toolbox.marketingtools.apple.com) and kept as local files so the page makes
   no external request. The files are not modified; Apple's guidelines ask for
   at least 40 px of height and clear space around the badge. */
import type { Locale } from '../i18n/config';
import { t } from '../i18n/ui';
import appStoreEn from '../assets/badges/app-store-en.svg';
import appStoreDe from '../assets/badges/app-store-de.svg';
import macAppStoreEn from '../assets/badges/mac-app-store-en.svg';
import macAppStoreDe from '../assets/badges/mac-app-store-de.svg';

interface Props {
  href: string;
  mac?: boolean;
  lang: Locale;
}
const { href, mac = false, lang }: Props = Astro.props;
const label = mac ? t(lang).macAppStore : t(lang).appStore;
const badges = {
  en: { app: appStoreEn, mac: macAppStoreEn },
  de: { app: appStoreDe, mac: macAppStoreDe },
};
const badge = badges[lang][mac ? 'mac' : 'app'];
const height = 44;
const width = Math.round((badge.width / badge.height) * height);
---

<a class="sb" href={href} rel="noopener" target="_blank" aria-label={label}>
  <img src={badge.src} alt={label} width={width} height={height} loading="lazy" decoding="async" />
</a>

<style>
  .sb {
    display: inline-flex;
    line-height: 0;
  }
  .sb img {
    height: 44px;
    width: auto;
  }
</style>
