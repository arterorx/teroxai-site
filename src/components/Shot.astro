---
/* One store screenshot by slug and index. The rendered width follows the
   image's own orientation: phone shots are tall, Mac shots are wide, and an
   app that ships on both may lead with either. */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  slug: string;
  n: number;
  alt: string;
  /** Width for a tall (portrait) image. */
  portrait?: number;
  /** Width for a wide (landscape) image. */
  landscape?: number;
  class?: string;
}
const { slug, n, alt, portrait = 320, landscape = 640, class: cls }: Props = Astro.props;
const shots = import.meta.glob<{ default: ImageMetadata }>('../assets/apps/*/shot-*.png', { eager: true });
const img = shots[`../assets/apps/${slug}/shot-${n}.png`]?.default;
const width = img && img.width > img.height ? landscape : portrait;
---

{img && <Image src={img} alt={alt} width={width} densities={[1, 2]} class:list={['shot', cls]} />}

<style>
  .shot {
    border-radius: 18px;
    box-shadow: var(--shadow);
    height: auto;
    max-width: 100%;
  }
</style>
