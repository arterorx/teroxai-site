---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { clusterFor, localePath, type Locale } from '../i18n/config';
import { aboutCopy } from '../i18n/about';
import Reveal from './Reveal.astro';
import { CONTACT_EMAIL, SITE_URL } from '../lib/site';
import SocialLinks from './SocialLinks.astro';
import armen from '../assets/armen.jpg';

interface Props {
  lang: Locale;
}
const { lang }: Props = Astro.props;
const c = aboutCopy[lang];
/* ProfilePage: tells Google this page is about the person behind the site. */
const profileLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ProfilePage',
    url: `${SITE_URL}${localePath(lang, 'about')}`,
    inLanguage: lang,
    dateCreated: '2026-09-10T00:00:00+02:00',
    dateModified: '2026-10-08T00:00:00+02:00',
    mainEntity: { '@id': `${SITE_URL}/#person` },
  },
];
---

<BaseLayout title={c.title} description={c.description} type="profile" lang={lang} alternates={clusterFor('about')} jsonLd={profileLd}>
  <article class="wrap section prose">
    <Image src={armen} alt="Armen Ter-Oganezov" width={180} height={180} densities={[1, 2]} class="photo" />
    <h1>{c.h1}</h1>
    <p class="lede">{c.lede}</p>
    {
      c.sections.map((s, i) => (
        <Reveal delay={i}>
          <h2>{s.h2}</h2>
          {s.paras.map((p) => <p>{p}</p>)}
        </Reveal>
      ))
    }
    <h2>{c.contactH2}</h2>
    <p>
      {c.contactText} <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
    </p>
    <SocialLinks lang={lang} class="links" />
  </article>
</BaseLayout>

<style>
  .photo {
    width: 180px;
    height: 180px;
    border-radius: 50%;
    object-fit: cover;
    margin-bottom: 1.5rem;
    box-shadow: 0 0 0 3px var(--rule);
  }
  .lede {
    font-size: 1.25rem;
    color: var(--ink-2);
  }
  :global(.links) {
    margin-top: 1rem;
  }
</style>
