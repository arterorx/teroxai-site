---
import { localePath, type Alternate, type Locale } from '../i18n/config';
import { SITE_NAME } from '../lib/site';
import { t } from '../i18n/ui';
import LangSwitcher from './LangSwitcher.astro';

interface Props {
  lang: Locale;
  alternates: Alternate[];
}
const { lang, alternates }: Props = Astro.props;
const ui = t(lang);
const nav = [
  { href: localePath(lang, 'apps'), label: ui.navApps },
  { href: localePath(lang, 'blog'), label: ui.navBlog },
  { href: localePath(lang, 'about'), label: ui.navAbout },
];
const path = Astro.url.pathname;
const isActive = (href: string) => path === href || (href !== localePath(lang) && path.startsWith(href));
---

<header class="hd">
  <div class="wrap hd__in">
    <a class="hd__brand" href={localePath(lang)}>{SITE_NAME}</a>
    <nav class="hd__nav" aria-label="Main">
      {nav.map((n) => <a href={n.href} aria-current={isActive(n.href) ? 'page' : undefined}>{n.label}</a>)}
    </nav>
    <LangSwitcher lang={lang} alternates={alternates} />
  </div>
</header>

<style>
  .hd {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--bg);
    border-bottom: 1px solid transparent;
    transition:
      background 0.25s ease,
      border-color 0.25s ease;
  }
  .hd.is-scrolled {
    background: rgb(255 255 255 / 0.82);
    border-bottom-color: var(--rule);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
  }
  .hd__in {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 1.5rem;
    min-height: 60px;
  }
  .hd__brand {
    font-weight: 700;
    letter-spacing: 0.01em;
    color: var(--ink);
    text-decoration: none;
    font-size: 1.125rem;
    margin-right: auto;
  }
  .hd__nav {
    display: flex;
    gap: 1.25rem;
  }
  .hd__nav a {
    color: var(--ink-2);
    text-decoration: none;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
  .hd__nav a:hover,
  .hd__nav a[aria-current='page'] {
    color: var(--ink);
  }
  .hd__nav a[aria-current='page'] {
    text-decoration: underline;
    text-underline-offset: 0.35em;
    text-decoration-thickness: 2px;
  }
  /* Phones: brand and language switcher share the first row, the nav
     takes a full second row instead of clipping or scrolling sideways. */
  @media (max-width: 560px) {
    .hd__nav {
      order: 3;
      flex-basis: 100%;
      gap: 1.25rem;
      padding-bottom: 0.25rem;
    }
  }
</style>
