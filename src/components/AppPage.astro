---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import StoreBadge from './StoreBadge.astro';
import DeviceFrame from './DeviceFrame.astro';
import Reveal from './Reveal.astro';
import { linkColor, rgbTriplet } from '../lib/color';
import { clusterFor, localePath, type Locale } from '../i18n/config';
import { SITE_URL } from '../lib/site';
import { platformKey, privacyUrl, supportUrl, storeUrl, subtitleOf, type App } from '../lib/apps';
import { t } from '../i18n/ui';

interface Props {
  app: App;
  lang: Locale;
}
const { app, lang }: Props = Astro.props;
const ui = t(lang);
const c = app[lang];
const pk = platformKey(app.platforms);
const icons = import.meta.glob<{ default: ImageMetadata }>('../assets/apps/*/icon.png', { eager: true });
const shots = import.meta.glob('../assets/apps/*/shot-*.png', { eager: true });
const shotNumbers = [1, 2, 3].filter((n) => `../assets/apps/${app.slug}/shot-${n}.png` in shots);
const theme = `--accent:${app.accent};--accent-rgb:${rgbTriplet(app.accent)};--link-accent:${linkColor(app.accent)}`;

/* Meta description: the intro, cut at a word boundary if it runs past 155. */
const clip = (text: string, max = 155) => {
  if (text.length <= max) return text;
  const cut = text.slice(0, text.lastIndexOf(' ', max));
  return cut.replace(/[,;:]$/, '');
};
const iconModule = icons[`../assets/apps/${app.slug}/icon.png`];
if (!iconModule) throw new Error(`No icon for app "${app.slug}" at src/assets/apps/${app.slug}/icon.png`);
const icon = iconModule.default;
const isLive = app.status === 'live';
const rating = app.store.rating !== null && app.store.ratingCount > 0 ? app.store : null;

const os = app.platforms.map((p) => ({ ios: 'iOS', ipados: 'iPadOS', macos: 'macOS' })[p]).join(', ');
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: c.name,
    description: c.intro,
    operatingSystem: os,
    applicationCategory: pk === 'macos' ? 'UtilitiesApplication' : 'MobileApplication',
    url: `${SITE_URL}${localePath(lang, `apps/${app.slug}`)}`,
    image: `${SITE_URL}/og/${app.slug}.png`,
    author: { '@id': `${SITE_URL}/#person` },
    ...(isLive ? { installUrl: storeUrl(app) } : {}),
    ...(isLive && app.store.price !== undefined
      ? { offers: { '@type': 'Offer', price: app.store.price, priceCurrency: app.store.currency ?? 'USD', url: storeUrl(app) } }
      : {}),
    ...(rating
      ? { aggregateRating: { '@type': 'AggregateRating', ratingValue: rating.rating, ratingCount: rating.ratingCount } }
      : {}),
  },
  ...(c.faq
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'FAQPage',
          mainEntity: c.faq.map((f) => ({
            '@type': 'Question',
            name: f.q,
            acceptedAnswer: { '@type': 'Answer', text: f.a },
          })),
        },
      ]
    : []),
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: ui.home, item: `${SITE_URL}${localePath(lang)}` },
      { '@type': 'ListItem', position: 2, name: ui.allApps, item: `${SITE_URL}${localePath(lang, 'apps')}` },
      { '@type': 'ListItem', position: 3, name: c.name },
    ],
  },
];
---

<BaseLayout
  title={c.name}
  description={clip(c.intro)}
  ogImage={`/og/${app.slug}.png`}
  lang={lang}
  alternates={clusterFor(`apps/${app.slug}`)}
  jsonLd={jsonLd}
>
  <div class="herobg" style={theme}>
    <section class="wrap section hero">
      <div class="hero__text">
        <span class="hero__iconwrap" transition:name={`app-icon-${app.slug}`}>
          <Image src={icon} alt="" width={144} height={144} densities={[1, 2]} class="hero__icon" />
        </span>
        <h1 transition:name={`app-name-${app.slug}`}>{c.name}</h1>
        <p class="hero__sub">{subtitleOf(app, lang)}</p>
        <p class="measure">{c.intro}</p>
        <div class="hero__cta">
          {isLive ? <StoreBadge href={storeUrl(app)} mac={pk === 'macos'} lang={lang} /> : <span class="badge">{ui.inReview}</span>}
          {app.site && (
            <a class="hero__site" href={app.site} rel="noopener">
              {ui.appSite}: {app.site.replace('https://', '')}
            </a>
          )}
        </div>
        {!isLive && <p class="muted">{ui.inReviewLong}</p>}
        <dl class="facts">
          <div><dt>{ui.platform}</dt><dd>{ui.platforms[pk]}</dd></div>
          <div><dt>{ui.price}</dt><dd>{c.priceLabel}</dd></div>
          {rating && (
            <div><dt>{ui.rating}</dt><dd>{rating.rating!.toFixed(1)} · {rating.ratingCount} {ui.ratings}</dd></div>
          )}
        </dl>
      </div>
      <div class="hero__device">
        <span class="glow" aria-hidden="true"></span>
        <DeviceFrame slug={app.slug} n={1} alt={`${c.name} screenshot`} portrait={300} landscape={620} eager priority class="hero__shot" />
      </div>
    </section>
  </div>

  <section class="wrap section" style={theme}>
    <h2>{ui.features}</h2>
    <div class="feats">
      {c.features.map((f, i) => (
        <Reveal delay={i % 3}>
          <div class="card feat">
            <i class="feat__mark" aria-hidden="true"></i>
            <h3>{f.title}</h3>
            <p>{f.text}</p>
          </div>
        </Reveal>
      ))}
    </div>
  </section>

  <section class="wrap section" style={theme}>
    <h2>{ui.moreShots}</h2>
    <div class="strip">
      {shotNumbers.map((n) => (
        <div class="strip__item">
          <DeviceFrame slug={app.slug} n={n} alt={`${c.name} screenshot ${n}`} portrait={260} landscape={560} />
        </div>
      ))}
    </div>
  </section>

  {
    c.faq && (
      <section class="wrap section" style={theme} aria-labelledby="faq-title">
        <h2 id="faq-title">{ui.faq}</h2>
        <div class="faq">
          {c.faq.map((f, i) => (
            <Reveal delay={i % 3}>
              <details class="faq__item" open={i === 0}>
                <summary>
                  <span class="faq__q">{f.q}</span>
                  <i class="faq__chev" aria-hidden="true"></i>
                </summary>
                <p>{f.a}</p>
              </details>
            </Reveal>
          ))}
        </div>
      </section>
    )
  }

  <section class="wrap section">
    <p class="muted">
      <a href={privacyUrl(app)}>{ui.privacy}</a> · <a href={supportUrl(app)}>{ui.support}</a> · <a class="more" href={localePath(lang, 'apps')}>{ui.allApps}</a>
    </p>
  </section>
</BaseLayout>

<style>
  .herobg {
    background: linear-gradient(180deg, rgb(var(--accent-rgb) / 0.14) 0%, rgb(var(--accent-rgb) / 0.04) 45%, var(--bg) 100%);
  }
  .hero {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 2.5rem;
    align-items: center;
    min-height: min(78vh, 720px);
  }
  /* Grid items default to a min-width driven by their content; without this,
     a wide (landscape) hero screenshot can force the whole grid past the
     viewport. */
  .hero__text,
  .hero__device {
    min-width: 0;
  }
  .hero__iconwrap {
    display: block;
    width: 72px;
    height: 72px;
    margin-bottom: 1rem;
  }
  .hero__icon {
    width: 72px;
    height: 72px;
    border-radius: 16px;
    box-shadow: 0 8px 24px rgb(var(--accent-rgb) / 0.25);
  }
  .hero__sub {
    font-size: 1.25rem;
    color: var(--ink-2);
  }
  .hero__cta {
    display: flex;
    gap: 1rem;
    align-items: center;
    flex-wrap: wrap;
    margin: 1.25rem 0 0.75rem;
  }
  .hero__site {
    color: var(--link-accent);
    font-weight: 600;
  }
  .badge {
    border: 1px solid var(--ink-3);
    border-radius: 999px;
    padding: 0.35rem 0.8rem;
    color: var(--ink-2);
  }
  .facts {
    display: flex;
    gap: 2rem;
    flex-wrap: wrap;
    margin: 1.25rem 0 0;
  }
  .facts div {
    margin: 0;
  }
  .facts dt {
    font-size: 0.8125rem;
    color: var(--ink-3);
  }
  .facts dd {
    margin: 0;
    font-weight: 600;
  }
  .hero__device {
    position: relative;
    /* flex, not grid: a grid container here fails to clamp a landscape
       screenshot's percentage max-width against the track, letting it
       overflow the viewport on narrow screens. */
    display: flex;
    justify-content: center;
    align-items: center;
    isolation: isolate;
  }
  .glow {
    position: absolute;
    inset: 12%;
    border-radius: 50%;
    background: var(--accent);
    filter: blur(64px);
    opacity: 0.35;
    z-index: -1;
    pointer-events: none;
  }
  /* The hero screenshot slides in with a slight tilt on first paint. The
     figure is rendered by DeviceFrame, so it carries that component's scope,
     hence :global. */
  .hero__device :global(.hero__shot) {
    animation: shot-in 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  @keyframes shot-in {
    from {
      opacity: 0;
      transform: translateY(24px) rotate(2deg);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .feats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  .feat {
    height: 100%;
  }
  .feat p {
    margin: 0;
  }
  .feat__mark {
    display: block;
    width: 14px;
    height: 14px;
    border-radius: 4px;
    background: var(--accent);
    margin-bottom: 0.75rem;
  }
  /* Questions and answers: native details, no script. The first one starts
     open so the section reads as content, not as a row of closed boxes. */
  .faq {
    max-width: 44rem;
    border-top: 1px solid var(--rule);
  }
  .faq__item {
    border-bottom: 1px solid var(--rule);
  }
  .faq__item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 0;
    cursor: pointer;
    list-style: none;
    font-weight: 600;
  }
  .faq__item summary::-webkit-details-marker {
    display: none;
  }
  .faq__item summary:hover .faq__q {
    color: var(--link-accent);
  }
  .faq__chev {
    flex: none;
    width: 10px;
    height: 10px;
    border-right: 2px solid var(--accent);
    border-bottom: 2px solid var(--accent);
    transform: rotate(45deg);
    transition: transform 0.2s ease;
    margin-right: 4px;
  }
  .faq__item[open] .faq__chev {
    transform: rotate(-135deg);
  }
  .faq__item p {
    margin: 0 0 1.25rem;
    color: var(--ink-2);
    max-width: 62ch;
  }
  /* Screenshot strip: snap scrolling, no script. */
  .strip {
    display: flex;
    gap: 1.5rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 0.5rem 0 1.25rem;
    scrollbar-width: thin;
    -webkit-overflow-scrolling: touch;
  }
  .strip__item {
    flex: none;
    scroll-snap-align: start;
  }
  /* Desktop: the strip drifts a little as the page scrolls, where the
     browser supports scroll-driven animations. The base rule has no duration,
     so without a scroll timeline it finishes instantly and the strip just
     sits. The timeline lives in its own rule on purpose: the CSS minifier
     folds animation-timeline into the animation shorthand when they share a
     block, and browsers drop the whole declaration. */
  .strip {
    animation: strip-drift linear both;
  }
  @keyframes strip-drift {
    from {
      transform: translateX(48px);
    }
    to {
      transform: none;
    }
  }
  @supports (animation-timeline: view()) {
    @media (min-width: 800px) and (prefers-reduced-motion: no-preference) {
      .strip {
        animation-timeline: view();
        animation-range: entry 0% cover 50%;
      }
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__device :global(.hero__shot),
    .strip {
      animation: none;
    }
  }
  @media (max-width: 800px) {
    .hero {
      grid-template-columns: 1fr;
      min-height: 0;
    }
    .feats {
      grid-template-columns: 1fr;
    }
    .glow {
      inset: 20%;
      filter: blur(48px);
    }
  }
</style>
