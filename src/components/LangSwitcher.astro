---
import { LOCALE_NAMES, LOCALE_TAGS, type Alternate, type Locale } from '../i18n/config';
import { t } from '../i18n/ui';

interface Props {
  lang: Locale;
  alternates: Alternate[];
}
const { lang, alternates }: Props = Astro.props;
---

{
  alternates.length > 1 && (
    <nav class="ls" aria-label={t(lang).langLabel}>
      {alternates.map((a) => (
        <a
          href={a.path}
          hreflang={LOCALE_TAGS[a.lang]}
          lang={LOCALE_TAGS[a.lang]}
          aria-current={a.lang === lang ? 'page' : undefined}
        >
          {LOCALE_NAMES[a.lang]}
        </a>
      ))}
    </nav>
  )
}

<style>
  .ls {
    display: flex;
    gap: 0.75rem;
    font-size: 0.875rem;
  }
  .ls a {
    color: var(--ink-3);
    text-decoration: none;
    min-height: 34px;
    display: inline-flex;
    align-items: center;
  }
  .ls a:hover {
    color: var(--ink);
  }
  .ls a[aria-current='page'] {
    color: var(--ink);
    font-weight: 600;
  }
</style>
