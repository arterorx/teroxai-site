---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import StoreBadge from './StoreBadge.astro';
import DeviceFrame from './DeviceFrame.astro';
import { clusterFor, localePath, type Locale } from '../i18n/config';
import { SITE_URL } from '../lib/site';
import { platformKey, privacyUrl, supportUrl, storeUrl, subtitleOf, type App } from '../lib/apps';
import { t } from '../i18n/ui';

interface Props {
  app: App;
  lang: Locale;
}
const { app, lang }: Props = Astro.props;
const ui = t(lang);
const c = app[lang];
const pk = platformKey(app.platforms);
const icons = import.meta.glob<{ default: ImageMetadata }>('../assets/apps/*/icon.png', { eager: true });
const shots = import.meta.glob('../assets/apps/*/shot-*.png', { eager: true });
const hasMoreShots = [2, 3].some((n) => `../assets/apps/${app.slug}/shot-${n}.png` in shots);

/* Meta description: the intro, cut at a word boundary if it runs past 155. */
const clip = (text: string, max = 155) => {
  if (text.length <= max) return text;
  const cut = text.slice(0, text.lastIndexOf(' ', max));
  return cut.replace(/[,;:]$/, '');
};
const iconModule = icons[`../assets/apps/${app.slug}/icon.png`];
if (!iconModule) throw new Error(`No icon for app "${app.slug}" at src/assets/apps/${app.slug}/icon.png`);
const icon = iconModule.default;
const isLive = app.status === 'live';
const rating = app.store.rating !== null && app.store.ratingCount > 0 ? app.store : null;

const os = app.platforms.map((p) => ({ ios: 'iOS', ipados: 'iPadOS', macos: 'macOS' })[p]).join(', ');
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: c.name,
    description: c.intro,
    operatingSystem: os,
    applicationCategory: pk === 'macos' ? 'UtilitiesApplication' : 'MobileApplication',
    url: `${SITE_URL}${localePath(lang, `apps/${app.slug}`)}`,
    image: `${SITE_URL}/og/${app.slug}.png`,
    author: { '@id': `${SITE_URL}/#person` },
    ...(isLive ? { installUrl: storeUrl(app) } : {}),
    ...(isLive && app.store.price !== undefined
      ? { offers: { '@type': 'Offer', price: app.store.price, priceCurrency: app.store.currency ?? 'USD', url: storeUrl(app) } }
      : {}),
    ...(rating
      ? { aggregateRating: { '@type': 'AggregateRating', ratingValue: rating.rating, ratingCount: rating.ratingCount } }
      : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: ui.home, item: `${SITE_URL}${localePath(lang)}` },
      { '@type': 'ListItem', position: 2, name: ui.allApps, item: `${SITE_URL}${localePath(lang, 'apps')}` },
      { '@type': 'ListItem', position: 3, name: c.name },
    ],
  },
];
---

<BaseLayout
  title={c.name}
  description={clip(c.intro)}
  ogImage={`/og/${app.slug}.png`}
  lang={lang}
  alternates={clusterFor(`apps/${app.slug}`)}
  jsonLd={jsonLd}
>
  <section class="wrap section hero">
    <div>
      <Image src={icon} alt="" width={72} height={72} densities={[1, 2]} class="hero__icon" />
      <h1>{c.name}</h1>
      <p class="hero__sub">{subtitleOf(app, lang)}</p>
      <p class="measure">{c.intro}</p>
      <div class="hero__cta">
        {isLive ? <StoreBadge href={storeUrl(app)} mac={pk === 'macos'} lang={lang} /> : <span class="badge">{ui.inReview}</span>}
        {app.site && <a href={app.site} rel="noopener">{ui.appSite}: {app.site.replace('https://', '')}</a>}
      </div>
      {!isLive && <p class="muted">{ui.inReviewLong}</p>}
      <dl class="facts">
        <div><dt>{ui.platform}</dt><dd>{ui.platforms[pk]}</dd></div>
        <div><dt>{ui.price}</dt><dd>{c.priceLabel}</dd></div>
        {rating && (
          <div><dt>{ui.rating}</dt><dd>{rating.rating!.toFixed(1)} · {rating.ratingCount} {ui.ratings}</dd></div>
        )}
      </dl>
    </div>
    <DeviceFrame slug={app.slug} n={1} alt={`${c.name} screenshot`} portrait={300} landscape={620} eager class="hero__shot" />
  </section>

  <section class="wrap section">
    <h2>{ui.features}</h2>
    <div class="feats">
      {c.features.map((f) => (
        <div class="card">
          <h3>{f.title}</h3>
          <p>{f.text}</p>
        </div>
      ))}
    </div>
  </section>

  {
    hasMoreShots && (
      <section class="wrap section shots">
        <h2>{ui.moreShots}</h2>
        <div class="shots__row">
          <DeviceFrame slug={app.slug} n={2} alt={`${c.name} screenshot 2`} portrait={260} landscape={540} />
          <DeviceFrame slug={app.slug} n={3} alt={`${c.name} screenshot 3`} portrait={260} landscape={540} />
        </div>
      </section>
    )
  }

  <section class="wrap section">
    <p class="muted">
      <a href={privacyUrl(app)}>{ui.privacy}</a> · <a href={supportUrl(app)}>{ui.support}</a> · <a href={localePath(lang, 'apps')}>{ui.allApps}</a>
    </p>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 2.5rem;
    align-items: center;
  }
  .hero__icon {
    width: 72px;
    height: 72px;
    border-radius: 16px;
    margin-bottom: 1rem;
  }
  .hero__sub {
    font-size: 1.25rem;
    color: var(--ink-2);
  }
  .hero__cta {
    display: flex;
    gap: 1rem;
    align-items: center;
    flex-wrap: wrap;
    margin: 1.25rem 0 0.75rem;
  }
  .badge {
    border: 1px solid var(--ink-3);
    border-radius: 999px;
    padding: 0.35rem 0.8rem;
    color: var(--ink-2);
  }
  .facts {
    display: flex;
    gap: 2rem;
    flex-wrap: wrap;
    margin: 1.25rem 0 0;
  }
  .facts div {
    margin: 0;
  }
  .facts dt {
    font-size: 0.8125rem;
    color: var(--ink-3);
  }
  .facts dd {
    margin: 0;
    font-weight: 600;
  }
  .hero__shot {
    justify-self: center;
    max-width: 100%;
  }
  .feats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  .feats p {
    margin: 0;
  }
  .shots__row {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  @media (max-width: 800px) {
    .hero {
      grid-template-columns: 1fr;
    }
    .feats {
      grid-template-columns: 1fr;
    }
  }
</style>
