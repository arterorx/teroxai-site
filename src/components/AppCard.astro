---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { localePath, type Locale } from '../i18n/config';
import { platformKey, type App } from '../lib/apps';
import { t } from '../i18n/ui';

interface Props {
  app: App;
  lang: Locale;
}
const { app, lang }: Props = Astro.props;
const ui = t(lang);
const icons = import.meta.glob<{ default: ImageMetadata }>('../assets/apps/*/icon.png', { eager: true });
const iconModule = icons[`../assets/apps/${app.slug}/icon.png`];
if (!iconModule) throw new Error(`AppCard: no icon.png for app "${app.slug}" in src/assets/apps/`);
const icon = iconModule.default;
const c = app[lang];
---

<a class="ac" href={localePath(lang, `apps/${app.slug}`)} style={`--accent:${app.accent}`}>
  <span class="ac__iconwrap" transition:name={`app-icon-${app.slug}`}>
    <Image src={icon} alt="" width={128} height={128} densities={[1, 2]} class="ac__icon" />
  </span>
  <span class="ac__name" transition:name={`app-name-${app.slug}`}>{c.name}</span>
  <span class="ac__tag">{c.tagline}</span>
  <span class="ac__meta">
    {ui.platforms[platformKey(app.platforms)]}
    {app.status === 'review' && <span class="ac__badge">{ui.inReview}</span>}
  </span>
</a>

<style>
  .ac {
    position: relative;
    display: grid;
    gap: 0.35rem;
    background: var(--card);
    border-radius: var(--radius);
    padding: 1.5rem 1.25rem 1.25rem;
    color: var(--ink);
    text-decoration: none;
    overflow: hidden;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }
  /* Accent bar along the top edge; grows on hover without shifting content. */
  .ac::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 3px;
    background: var(--accent);
    transition: height 0.2s ease;
  }
  .ac:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 30px rgb(0 0 0 / 0.08);
  }
  .ac:hover::before {
    height: 5px;
  }
  @media (prefers-reduced-motion: reduce) {
    .ac,
    .ac::before {
      transition: none;
    }
  }
  .ac__iconwrap {
    display: block;
    width: 64px;
    height: 64px;
    margin-bottom: 0.5rem;
  }
  .ac__icon {
    width: 64px;
    height: 64px;
    border-radius: 15px;
  }
  .ac__name {
    font-weight: 650;
    line-height: 1.25;
  }
  .ac__tag {
    color: var(--ink-2);
    font-size: 0.95rem;
  }
  .ac__meta {
    color: var(--ink-3);
    font-size: 0.8125rem;
    margin-top: 0.35rem;
    display: flex;
    gap: 0.5rem;
    align-items: center;
    flex-wrap: wrap;
  }
  .ac__badge {
    border: 1px solid var(--rule);
    border-radius: 999px;
    padding: 0.1rem 0.5rem;
  }
</style>
