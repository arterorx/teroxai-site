---
import BaseLayout from './BaseLayout.astro';
import { localePath, type Alternate, type Locale } from '../i18n/config';
import { SITE_URL, OWNER, formatDate } from '../lib/site';
import { t } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  date: Date;
  lang: Locale;
  slug: string;
  alternates: Alternate[];
  cover?: string;
  updated?: Date;
}
const { title, description, date, lang, slug, alternates, cover, updated }: Props = Astro.props;
const coverPath = cover ? `/og/blog/${cover}.png` : undefined;
const ui = t(lang);
const iso = date.toISOString().slice(0, 10);
const isoUpdated = (updated ?? date).toISOString().slice(0, 10);
/* Google asks for the article image in 16:9, 4:3 and 1:1. */
const images = cover
  ? ['16x9', '4x3', '1x1'].map((r) => `${SITE_URL}/og/blog/${cover}-${r}.png`)
  : [`${SITE_URL}/og/default.png`];
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: title,
    description,
    /* Google wants a full date-time with a time zone here, not a bare date. */
    datePublished: `${iso}T08:00:00+02:00`,
    dateModified: `${isoUpdated}T08:00:00+02:00`,
    inLanguage: lang,
    url: `${SITE_URL}${localePath(lang, `blog/${slug}`)}`,
    mainEntityOfPage: `${SITE_URL}${localePath(lang, `blog/${slug}`)}`,
    image: images,
    author: { '@type': 'Person', '@id': `${SITE_URL}/#person`, name: OWNER, url: `${SITE_URL}/about/` },
    publisher: { '@id': `${SITE_URL}/#org` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: ui.home, item: `${SITE_URL}${localePath(lang)}` },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: `${SITE_URL}${localePath(lang, 'blog')}` },
      { '@type': 'ListItem', position: 3, name: title },
    ],
  },
];
---

<BaseLayout title={title} description={description} type="article" lang={lang} alternates={alternates} jsonLd={jsonLd} ogImage={coverPath}>
  <article class="wrap section prose">
    <p class="muted">
      <time datetime={iso}>{formatDate(iso, lang)}</time> · {OWNER}
      {updated && (
        <>
          {' '}· {ui.updated} <time datetime={isoUpdated}>{formatDate(isoUpdated, lang)}</time>
        </>
      )}
    </p>
    <h1>{title}</h1>
    {coverPath && <img class="cover" src={coverPath} alt="" width="1200" height="630" fetchpriority="high" />}
    <div class="post">
      <slot />
    </div>
    <p><a class="more more--back" href={localePath(lang, 'blog')}>{ui.backToBlog}</a></p>
  </article>
</BaseLayout>

<style>
  .cover {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 14px;
    margin: 1.5rem 0 2rem;
  }
  .post > :global(p:first-of-type) {
    font-size: 1.2rem;
    color: var(--ink-2);
  }
</style>
