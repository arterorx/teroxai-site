---
/* Language pill: short codes, the active one filled. The full language name
   goes into aria-label and the link carries lang/hreflang for assistive tech. */
import { LOCALE_NAMES, LOCALE_TAGS, type Alternate, type Locale } from '../i18n/config';
import { t } from '../i18n/ui';

interface Props {
  lang: Locale;
  alternates: Alternate[];
}
const { lang, alternates }: Props = Astro.props;
---

{
  alternates.length > 1 && (
    <nav class="ls" aria-label={t(lang).langLabel}>
      {alternates.map((a) => (
        <a
          href={a.path}
          hreflang={LOCALE_TAGS[a.lang]}
          lang={LOCALE_TAGS[a.lang]}
          aria-label={LOCALE_NAMES[a.lang]}
          aria-current={a.lang === lang ? 'page' : undefined}
        >
          {a.lang.toUpperCase()}
        </a>
      ))}
    </nav>
  )
}

<style>
  .ls {
    display: inline-flex;
    border: 1px solid var(--rule);
    border-radius: 999px;
    padding: 2px;
    gap: 2px;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }
  .ls a {
    color: var(--ink-3);
    text-decoration: none;
    min-height: 28px;
    min-width: 36px;
    padding: 0 0.6rem;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition:
      background 0.2s ease,
      color 0.2s ease;
  }
  .ls a:hover {
    color: var(--ink);
  }
  .ls a[aria-current='page'] {
    background: var(--ink);
    color: var(--bg);
  }
  @media (prefers-reduced-motion: reduce) {
    .ls a {
      transition: none;
    }
  }
</style>
