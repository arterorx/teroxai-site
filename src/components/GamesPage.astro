---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { clusterFor, localePath, type Locale } from '../i18n/config';
import { games, pagePath } from '../lib/apps';

interface Props {
  lang: Locale;
}
const { lang }: Props = Astro.props;

const copy = {
  en: {
    title: 'Games',
    description: 'Games from TeroxAI for iPhone, iPad and Mac: Bone Caster, a dice roguelike, and Lampfall, a turn-based dungeon crawler.',
    hud: 'Select game',
    slots: (n: number) => `${n} / 3 unlocked`,
    lead: ['Three games are on the way. All of them are still locked.', 'The first game is out. Two more are still locked.', 'Two games are out. One more is still locked.', 'All three games are out.'],
    play: 'Play',
    platforms: 'iPhone · iPad · Mac',
    locked: 'Locked',
    soon: 'Coming soon',
    cardLabel: 'Locked game, coming soon',
    back: 'Meanwhile, the apps are open',
  },
  de: {
    title: 'Spiele',
    description: 'Spiele von TeroxAI für iPhone, iPad und Mac: Bone Caster, ein Würfel-Roguelike, und Lampfall, ein rundenbasierter Dungeon-Crawler.',
    hud: 'Spiel wählen',
    slots: (n: number) => `${n} / 3 freigeschaltet`,
    lead: ['Drei Spiele sind unterwegs. Alle sind noch gesperrt.', 'Das erste Spiel ist da. Zwei weitere sind noch gesperrt.', 'Zwei Spiele sind da. Eines ist noch gesperrt.', 'Alle drei Spiele sind da.'],
    play: 'Spielen',
    platforms: 'iPhone · iPad · Mac',
    locked: 'Gesperrt',
    soon: 'Demnächst',
    cardLabel: 'Gesperrtes Spiel, demnächst',
    back: 'Bis dahin sind die Apps offen',
  },
}[lang];

/* Three slots. Released games (kind "game" in apps.json) fill them from the
   left with a card that links to the game's own page; the rest stay locked. */
const icons = import.meta.glob<{ default: ImageMetadata }>('../assets/apps/*/icon.png', { eager: true });
const released = games().filter((g) => g.status === 'live').slice(0, 3);
const slots = [1, 2, 3].map((n) => ({ n, game: released[n - 1] }));
const shortName = (name: string) => name.split(':')[0];
---

<BaseLayout title={copy.title} description={copy.description} lang={lang} alternates={clusterFor('games')}>
  <section class="gm">
    <div class="gm__floor" aria-hidden="true"></div>
    <div class="wrap gm__in">
      <p class="gm__hud">
        <span>{copy.hud}<i class="gm__cursor" aria-hidden="true"></i></span>
        <span>{copy.slots(released.length)}</span>
      </p>
      <h1 class="gm__title">{copy.title}</h1>
      <p class="gm__lead">{copy.lead[released.length]}</p>

      <ul class="gm__deck" role="list">
        {
          slots.map(({ n, game }) =>
            game ? (
              <li class="gm__card gm__card--open" style={`--i:${n - 1};--ga:${game.accent}`}>
                <a class="gm__link" href={localePath(lang, pagePath(game))}>
                  <span class="gm__no">{String(n).padStart(2, '0')}</span>
                  <span class="gm__art">
                    <Image src={icons[`../assets/apps/${game.slug}/icon.png`].default} alt="" width={160} height={160} densities={[1, 2]} class="gm__icon" />
                  </span>
                  <span class="gm__name">{shortName(game[lang].name)}</span>
                  <span class="gm__tag">{game[lang].tagline}</span>
                  <span class="gm__play">
                    {copy.play}
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
                  </span>
                </a>
              </li>
            ) : (
            <li class="gm__card" style={`--i:${n - 1}`} aria-label={copy.cardLabel}>
              <span class="gm__no" aria-hidden="true">{String(n).padStart(2, '0')}</span>
              <span class="gm__q" aria-hidden="true" data-q="?">?</span>
              <span class="gm__lock" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="5" y="11" width="14" height="10" rx="2" />
                  <path d="M8 11V7a4 4 0 0 1 8 0v4" />
                </svg>
                {copy.locked}
              </span>
            </li>
            ),
          )
        }
      </ul>

      {released.length < 3 && <p class="gm__soon"><span>{copy.soon}</span></p>}
      <p class="gm__back"><a href={localePath(lang, 'apps')}>{copy.back}</a></p>
    </div>
  </section>
</BaseLayout>

<style>
  .gm {
    --g1: #c8894f;
    --g2: #7c5cff;
    position: relative;
    overflow: hidden;
    background: radial-gradient(120% 80% at 50% 0%, #1b1830 0%, #0c0c11 55%, #08080b 100%);
    color: #fff;
    padding: clamp(2.5rem, 7vw, 5rem) 0 clamp(5rem, 14vw, 9rem);
  }
  /* Retro floor: a grid tilted away from the viewer, sliding slowly forward. */
  .gm__floor {
    position: absolute;
    inset: auto -20% 0;
    height: 46%;
    background-image:
      linear-gradient(90deg, rgb(124 92 255 / 0.4) 1px, transparent 1px),
      linear-gradient(0deg, rgb(124 92 255 / 0.4) 1px, transparent 1px);
    background-size: 72px 72px;
    transform: perspective(420px) rotateX(62deg);
    transform-origin: 50% 100%;
    -webkit-mask-image: linear-gradient(to top, #000 10%, transparent 85%);
    mask-image: linear-gradient(to top, #000 10%, transparent 85%);
    animation: gm-floor 5s linear infinite;
  }
  .gm__in {
    position: relative;
    text-align: center;
  }
  .gm__hud {
    display: flex;
    justify-content: space-between;
    margin: 0 auto 1.5rem;
    max-width: 780px;
    font: 600 0.8rem/1 ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #9a9aa8;
  }
  .gm__cursor {
    display: inline-block;
    width: 0.6em;
    height: 1em;
    margin-left: 0.4em;
    vertical-align: -0.12em;
    background: var(--g1);
    animation: gm-blink 1.1s steps(1) infinite;
  }
  .gm__title {
    margin: 0;
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(2.8rem, 9vw, 5.5rem);
    line-height: 1;
    letter-spacing: -0.02em;
    background: linear-gradient(100deg, #fff 30%, var(--g1) 60%, var(--g2) 95%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .gm__lead {
    margin: 1rem auto 0;
    max-width: 34ch;
    color: #b9b9c6;
    font-size: 1.05rem;
  }

  .gm__deck {
    list-style: none;
    margin: clamp(2.5rem, 7vw, 4.5rem) auto 0;
    padding: 0;
    max-width: 780px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(0.6rem, 2.4vw, 1.5rem);
    perspective: 1200px;
  }
  /* Three cards held in a loose fan. Hover straightens and lifts one. */
  .gm__card {
    --tilt: calc((var(--i) - 1) * 4deg);
    --drop: calc((var(--i) - 1) * (var(--i) - 1) * 14px);
    position: relative;
    aspect-ratio: 3 / 4;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    padding: clamp(0.6rem, 2vw, 1.1rem);
    border-radius: clamp(10px, 2vw, 18px);
    overflow: hidden;
    background:
      repeating-linear-gradient(135deg, rgb(255 255 255 / 0.025) 0 2px, transparent 2px 9px),
      linear-gradient(160deg, #1d1d27, #101016);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.09),
      0 24px 50px rgb(0 0 0 / 0.55);
    transform: translateY(var(--drop)) rotate(var(--tilt));
    transition:
      transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1),
      box-shadow 0.35s ease;
    cursor: not-allowed;
    -webkit-user-select: none;
    user-select: none;
  }
  /* A slow band of light crossing each card in turn. */
  .gm__card::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(105deg, transparent 40%, rgb(255 255 255 / 0.1) 50%, transparent 60%);
    transform: translateX(-120%);
    animation: gm-sweep 6s ease-in-out infinite;
    animation-delay: calc(var(--i) * 0.9s);
    pointer-events: none;
  }
  .gm__no,
  .gm__lock {
    font: 600 clamp(0.6rem, 1.6vw, 0.78rem)/1 ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #70707e;
  }
  .gm__no {
    align-self: flex-start;
  }
  .gm__lock {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
  }
  .gm__lock svg {
    width: 1.25em;
    height: 1.25em;
    flex: none;
  }
  .gm__q {
    position: relative;
    font-family: var(--serif);
    font-size: clamp(3.4rem, 15vw, 9rem);
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1.5px rgb(255 255 255 / 0.2);
    animation: gm-breathe 4s ease-in-out infinite;
    animation-delay: calc(var(--i) * 0.6s);
  }
  /* Coloured twin of the question mark, shown and shaken on hover. */
  .gm__q::before {
    content: attr(data-q);
    position: absolute;
    inset: 0;
    background: linear-gradient(140deg, var(--g1), var(--g2));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-stroke: 0;
    opacity: 0;
    transition: opacity 0.25s ease;
  }
  @media (hover: hover) {
    .gm__card:hover {
      transform: translateY(-14px) rotate(0deg) scale(1.04);
      box-shadow:
        inset 0 0 0 1.5px rgb(200 137 79 / 0.9),
        0 0 0 1px rgb(124 92 255 / 0.5),
        0 30px 70px rgb(124 92 255 / 0.35);
      z-index: 2;
    }
    .gm__card:hover .gm__q::before {
      opacity: 1;
      animation: gm-glitch 0.9s steps(2) infinite;
    }
    .gm__card:hover .gm__lock {
      color: #e7c3a1;
    }
  }
  /* Pressing a locked card: it refuses with a shake. */
  .gm__card:active {
    animation: gm-shake 0.35s linear;
  }
  .gm__card:active .gm__lock {
    color: #ff8a80;
  }

  /* A released game: the card lights up in the game's colour and opens its page. */
  .gm__card--open {
    cursor: pointer;
    padding: 0;
    background:
      radial-gradient(90% 60% at 50% 38%, color-mix(in srgb, var(--ga) 32%, transparent), transparent 70%),
      linear-gradient(160deg, #22202a, #111016);
    box-shadow:
      inset 0 0 0 1.5px color-mix(in srgb, var(--ga) 85%, transparent),
      0 0 34px color-mix(in srgb, var(--ga) 30%, transparent),
      0 24px 50px rgb(0 0 0 / 0.55);
  }
  .gm__link {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    height: 100%;
    padding: clamp(0.6rem, 2vw, 1.1rem);
    color: #fff;
    text-decoration: none;
  }
  .gm__card--open .gm__no {
    color: color-mix(in srgb, var(--ga) 80%, white);
  }
  .gm__art {
    width: 62%;
    aspect-ratio: 1;
    border-radius: 22%;
    overflow: hidden;
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.5);
    animation: gm-float 4s ease-in-out infinite;
  }
  .gm__icon {
    display: block;
    width: 100%;
    height: 100%;
    image-rendering: pixelated;
  }
  .gm__name {
    margin-top: 0.4em;
    font-family: var(--serif);
    font-size: clamp(0.95rem, 2.8vw, 1.6rem);
    line-height: 1.1;
  }
  .gm__tag {
    font-size: clamp(0.62rem, 1.6vw, 0.82rem);
    line-height: 1.3;
    color: #b9b9c6;
    max-width: 22ch;
  }
  .gm__play {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    margin-top: 0.5em;
    padding: 0.45em 0.9em;
    border-radius: 999px;
    background: var(--ga);
    color: #160c06;
    font: 700 clamp(0.62rem, 1.6vw, 0.8rem)/1 ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .gm__card--open:active {
    animation: none;
  }
  @media (hover: hover) {
    .gm__card--open:hover {
      box-shadow:
        inset 0 0 0 2px var(--ga),
        0 0 0 1px color-mix(in srgb, var(--ga) 50%, transparent),
        0 30px 70px color-mix(in srgb, var(--ga) 45%, transparent);
    }
  }
  @keyframes gm-float {
    50% {
      transform: translateY(-5px);
    }
  }
  @media (max-width: 560px) {
    .gm__tag {
      display: none;
    }
  }

  .gm__soon {
    margin: clamp(3rem, 9vw, 5rem) 0 0;
    font: 600 0.85rem/1 ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: #fff;
  }
  .gm__soon span {
    animation: gm-blink 1.6s steps(1) infinite;
  }
  .gm__back {
    margin: 1.25rem 0 0;
    font-size: 0.95rem;
  }
  .gm__back a {
    color: #b9b9c6;
    text-decoration-color: rgb(255 255 255 / 0.3);
    text-underline-offset: 0.3em;
  }
  .gm__back a:hover {
    color: #fff;
  }

  @keyframes gm-floor {
    to {
      background-position: 0 72px;
    }
  }
  @keyframes gm-blink {
    50% {
      opacity: 0;
    }
  }
  @keyframes gm-breathe {
    50% {
      -webkit-text-stroke-color: rgb(255 255 255 / 0.42);
    }
  }
  @keyframes gm-sweep {
    0%,
    55% {
      transform: translateX(-120%);
    }
    85%,
    100% {
      transform: translateX(120%);
    }
  }
  @keyframes gm-glitch {
    0% {
      transform: translate(0, 0);
      clip-path: inset(0 0 0 0);
    }
    25% {
      transform: translate(-3px, 1px);
      clip-path: inset(12% 0 48% 0);
    }
    50% {
      transform: translate(3px, -1px);
      clip-path: inset(55% 0 8% 0);
    }
    75% {
      transform: translate(-1px, 2px);
      clip-path: inset(30% 0 30% 0);
    }
    100% {
      transform: translate(0, 0);
      clip-path: inset(0 0 0 0);
    }
  }
  @keyframes gm-shake {
    20% {
      translate: -7px 0;
    }
    40% {
      translate: 7px 0;
    }
    60% {
      translate: -4px 0;
    }
    80% {
      translate: 4px 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .gm__floor,
    .gm__cursor,
    .gm__card::after,
    .gm__q,
    .gm__soon span,
    .gm__card:active,
    .gm__card:hover .gm__q::before,
    .gm__art {
      animation: none;
    }
    .gm__card {
      transition: none;
    }
  }
</style>
