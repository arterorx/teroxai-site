---
import { getCollection, getEntry, render } from 'astro:content';
import PostLayout from '../../../layouts/PostLayout.astro';
import { localePath, OTHER_LOCALES, type Alternate } from '../../../i18n/config';
import { slugOf } from '../../../lib/posts';

export async function getStaticPaths() {
  const posts = await getCollection('blog', (p) => p.data.lang !== 'en');
  return posts
    .filter((post) => (OTHER_LOCALES as readonly string[]).includes(post.data.lang))
    .map((post) => ({ params: { lang: post.data.lang, slug: slugOf(post.id) }, props: { post } }));
}
const { post } = Astro.props;
const lang = post.data.lang;
const slug = slugOf(post.id);
const { Content } = await render(post);
const alternates: Alternate[] = [];
if (post.data.translationOf) {
  const pair = await getEntry('blog', `en/${post.data.translationOf}`);
  if (!pair) throw new Error(`${post.id}: translationOf "${post.data.translationOf}" has no en/ post`);
  alternates.push({ lang: 'en', path: localePath('en', `blog/${post.data.translationOf}`) });
}
alternates.push({ lang, path: localePath(lang, `blog/${slug}`) });
---

<PostLayout title={post.data.title} description={post.data.description} date={post.data.date} lang={lang} slug={slug} alternates={alternates} cover={post.data.cover}>
  <Content />
</PostLayout>
