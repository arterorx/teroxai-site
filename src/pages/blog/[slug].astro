---
import { getCollection, getEntry, render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import { localePath, type Alternate } from '../../i18n/config';
import { slugOf } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getCollection('blog', (p) => p.data.lang === 'en');
  return posts.map((post) => ({ params: { slug: slugOf(post.id) }, props: { post } }));
}
const { post } = Astro.props;
const slug = slugOf(post.id);
const { Content } = await render(post);
const alternates: Alternate[] = [{ lang: 'en', path: localePath('en', `blog/${slug}`) }];
if (post.data.translationOf) {
  /* A dead hreflang is worse than none: fail the build if the pair is missing. */
  const pair = await getEntry('blog', `de/${post.data.translationOf}`);
  if (!pair) throw new Error(`${post.id}: translationOf "${post.data.translationOf}" has no de/ post`);
  alternates.push({ lang: 'de', path: localePath('de', `blog/${post.data.translationOf}`) });
}
---

<PostLayout title={post.data.title} description={post.data.description} date={post.data.date} lang="en" slug={slug} alternates={alternates}>
  <Content />
</PostLayout>
