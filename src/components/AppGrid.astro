---
import AppCard from './AppCard.astro';
import Reveal from './Reveal.astro';
import type { Locale } from '../i18n/config';
import type { App } from '../lib/apps';

interface Props {
  apps: App[];
  lang: Locale;
}
const { apps, lang }: Props = Astro.props;
---

<div class="ag">
  {
    apps.map((app, i) => (
      <Reveal delay={i % 4}>
        <AppCard app={app} lang={lang} />
      </Reveal>
    ))
  }
</div>

<style>
  .ag {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(4, 1fr);
  }
  .ag > :global(.reveal) {
    display: grid;
  }
  @media (max-width: 900px) {
    .ag {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 480px) {
    .ag {
      grid-template-columns: 1fr;
    }
  }
</style>
