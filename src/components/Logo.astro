---
/* The TeroxAI mark: an app-icon square with a T and a four-point spark, plus
   the wordmark "Terox" with "AI" in the brand gradient. The same shapes live
   in scripts/icons.mjs (favicons) and scripts/og.mjs (share cards); change
   them together. */
interface Props {
  /** Mark size in px. */
  size?: number;
  /** Render the wordmark next to the mark. */
  wordmark?: boolean;
  class?: string;
}
const { size = 26, wordmark = true, class: cls }: Props = Astro.props;
---

<span class:list={['logo', cls]}>
  <svg class="logo__mark" width={size} height={size} viewBox="0 0 64 64" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id="logo-spark" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#C8894F"></stop>
        <stop offset="1" stop-color="#7C5CFF"></stop>
      </linearGradient>
    </defs>
    <rect width="64" height="64" rx="15" fill="#111"></rect>
    <rect x="15" y="17" width="30" height="8" rx="3" fill="#fff"></rect>
    <rect x="26" y="17" width="12" height="30" rx="3" fill="#fff"></rect>
    <path d="M49 10 L51.2 16.8 L58 19 L51.2 21.2 L49 28 L46.8 21.2 L40 19 L46.8 16.8 Z" fill="url(#logo-spark)"></path>
  </svg>
  {
    wordmark && (
      <span class="logo__word">
        Terox<span class="logo__ai">AI</span>
      </span>
    )
  }
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--ink);
  }
  .logo__mark {
    flex: none;
    display: block;
  }
  .logo__word {
    font-weight: 800;
    font-size: 1.125rem;
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .logo__ai {
    background: linear-gradient(90deg, #c8894f, #7c5cff);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
</style>
