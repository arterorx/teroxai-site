---
import AppCard from './AppCard.astro';
import Reveal from './Reveal.astro';
import type { Locale } from '../i18n/config';
import type { App } from '../lib/apps';

interface Props {
  apps: App[];
  lang: Locale;
}
const { apps, lang }: Props = Astro.props;

/* Rows are always full. Up to five apps sit in one row; larger sets use the
   widest of 3, 5 or 4 columns that divides the count. On tablets the grid has
   two columns, and an odd last card spans both. */
const n = apps.length;
const cols = n <= 5 ? n : n % 3 === 0 ? 3 : n % 5 === 0 ? 5 : n % 4 === 0 ? 4 : 3;
---

<div class:list={['ag', { 'ag--odd': n % 2 === 1 }]} style={`--cols:${cols}`}>
  {
    apps.map((app, i) => (
      <Reveal delay={i % 4}>
        <AppCard app={app} lang={lang} />
      </Reveal>
    ))
  }
</div>

<style>
  .ag {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(var(--cols), 1fr);
    /* Two or three cards should not stretch across the whole page. */
    max-width: calc(var(--cols) * 380px);
  }
  .ag > :global(.reveal) {
    display: grid;
  }
  @media (max-width: 900px) {
    .ag {
      grid-template-columns: repeat(2, 1fr);
      max-width: none;
    }
    .ag--odd > :global(.reveal:last-child) {
      grid-column: span 2;
    }
  }
  @media (max-width: 480px) {
    .ag {
      grid-template-columns: 1fr;
    }
  }
</style>
