---
import { localePath, type Locale } from '../i18n/config';
import { CONTACT_EMAIL, OWNER, CREDIT } from '../lib/site';
import SocialLinks from './SocialLinks.astro';
import { t } from '../i18n/ui';

interface Props {
  lang: Locale;
}
const { lang }: Props = Astro.props;
const ui = t(lang);
const year = new Date().getFullYear();
---

<footer class="ft">
  <div class="wrap ft__in">
    <p class="ft__open">
      {ui.openTo} {ui.writeMe} <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
    </p>
    <nav class="ft__links" aria-label="Footer">
      <SocialLinks lang={lang} look="plain" />
      <a href={localePath(lang, 'privacy')}>{ui.privacy}</a>
    </nav>
    <div class="ft__bottom">
      <p class="muted ft__copy">© {year} {OWNER}</p>
      <p class="muted ft__credit">
        {ui.websitesBy} <a href={CREDIT.url} rel="noopener" target="_blank">{CREDIT.name}</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .ft {
    border-top: 1px solid var(--rule);
    padding-block: 2.5rem;
    font-size: 0.9375rem;
  }
  .ft__in {
    display: grid;
    gap: 1rem;
  }
  .ft__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem;
  }
  .ft__links a {
    color: var(--ink-2);
  }
  .ft__bottom {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .ft__copy,
  .ft__credit {
    margin: 0;
  }
  .ft__credit a {
    color: var(--ink-2);
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
    transition: border-color 0.2s ease;
  }
  .ft__credit a:hover {
    color: var(--ink);
    border-bottom-color: var(--ink);
  }
</style>
