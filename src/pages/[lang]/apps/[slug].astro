---
import AppPage from '../../../components/AppPage.astro';
import { appsOnly } from '../../../lib/apps';
import { OTHER_LOCALES } from '../../../i18n/config';

export function getStaticPaths() {
  return OTHER_LOCALES.flatMap((lang) => appsOnly().map((app) => ({ params: { lang, slug: app.slug }, props: { app, lang } })));
}
const { app, lang } = Astro.props;
---

<AppPage app={app} lang={lang} />
