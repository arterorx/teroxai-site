---
import BaseLayout from './BaseLayout.astro';
import { localePath, type Alternate, type Locale } from '../i18n/config';
import { SITE_URL, OWNER, formatDate } from '../lib/site';
import { t } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  date: Date;
  lang: Locale;
  slug: string;
  alternates: Alternate[];
  cover?: string;
}
const { title, description, date, lang, slug, alternates, cover }: Props = Astro.props;
const coverPath = cover ? `/og/blog/${cover}.png` : undefined;
const ui = t(lang);
const iso = date.toISOString().slice(0, 10);
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: title,
    description,
    datePublished: iso,
    inLanguage: lang,
    url: `${SITE_URL}${localePath(lang, `blog/${slug}`)}`,
    mainEntityOfPage: `${SITE_URL}${localePath(lang, `blog/${slug}`)}`,
    image: `${SITE_URL}${coverPath ?? '/og/default.png'}`,
    author: { '@id': `${SITE_URL}/#person` },
    publisher: { '@id': `${SITE_URL}/#org` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: ui.home, item: `${SITE_URL}${localePath(lang)}` },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: `${SITE_URL}${localePath(lang, 'blog')}` },
      { '@type': 'ListItem', position: 3, name: title },
    ],
  },
];
---

<BaseLayout title={title} description={description} type="article" lang={lang} alternates={alternates} jsonLd={jsonLd} ogImage={coverPath}>
  <article class="wrap section prose">
    <p class="muted"><time datetime={iso}>{formatDate(iso, lang)}</time> · {OWNER}</p>
    <h1>{title}</h1>
    {coverPath && <img class="cover" src={coverPath} alt="" width="1200" height="630" fetchpriority="high" />}
    <div class="post">
      <slot />
    </div>
    <p><a class="more more--back" href={localePath(lang, 'blog')}>{ui.backToBlog}</a></p>
  </article>
</BaseLayout>

<style>
  .cover {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 14px;
    margin: 1.5rem 0 2rem;
  }
  .post > :global(p:first-of-type) {
    font-size: 1.2rem;
    color: var(--ink-2);
  }
</style>
