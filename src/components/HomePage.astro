---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import AppGrid from './AppGrid.astro';
import AppShowcase from './AppShowcase.astro';
import HeroParticles from './HeroParticles.astro';
import PostList from './PostList.astro';
import Reveal from './Reveal.astro';
import { clusterFor, localePath, type Locale } from '../i18n/config';
import { APPS, liveApps } from '../lib/apps';
import { homeCopy } from '../i18n/home';
import { t } from '../i18n/ui';
import SocialLinks from './SocialLinks.astro';
import armen from '../assets/armen.jpg';

interface Props {
  lang: Locale;
}
const { lang }: Props = Astro.props;
const n = liveApps().length;
const c = homeCopy(lang, n);
const ui = t(lang);
const firstAccent = liveApps()[0].accent;
---

<BaseLayout title={c.title} description={c.description} suffix={false} lang={lang} alternates={clusterFor()}>
  <section class="wrap section hero" data-accent-host style={`--hero-accent:${firstAccent}`}>
    <HeroParticles />
    <div class="hero__text">
      <h1 class="measure">{c.h1}</h1>
      <p class="hero__lede measure">{c.lede}</p>
      <a class="btn" href="#apps">{c.cta}</a>
    </div>
    <AppShowcase lang={lang} />
  </section>

  <section class="wrap section" id="apps">
    <Reveal>
      <p class="eyebrow">{c.appsEyebrow}</p>
      <h2>{c.appsH2}</h2>
    </Reveal>
    <AppGrid apps={APPS} lang={lang} />
  </section>

  <Reveal>
    <section class="wrap section">
      <p class="eyebrow">{ui.latestPosts}</p>
      <h2>Blog</h2>
      <PostList lang={lang} limit={3} />
      <p><a class="more" href={localePath(lang, 'blog')}>{ui.allPosts}</a></p>
    </section>
  </Reveal>

  <Reveal>
    <section class="wrap section about">
      <Image src={armen} alt="Armen Ter-Oganezov" width={160} height={160} densities={[1, 2]} class="about__photo" />
      <div>
        <p class="eyebrow">{c.aboutEyebrow}</p>
        <h2>{c.aboutH2}</h2>
        {c.aboutText.map((p) => <p class="measure">{p}</p>)}
        <div class="about__links">
          <SocialLinks lang={lang} />
          <a class="more" href={localePath(lang, 'about')}>{ui.moreAbout}</a>
        </div>
      </div>
    </section>
  </Reveal>
</BaseLayout>

<style>
  .hero {
    position: relative;
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 2rem;
    align-items: center;
    min-height: min(82vh, 760px);
  }
  .hero__text,
  .hero > :global(.sc) {
    position: relative;
    z-index: 1;
    min-width: 0;
  }
  .hero__lede {
    font-size: 1.25rem;
    color: var(--ink-2);
    margin-bottom: 1.5rem;
  }
  .about {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: 2rem;
    align-items: start;
  }
  .about__photo {
    border-radius: 50%;
    width: 160px;
    height: 160px;
    object-fit: cover;
    box-shadow: 0 0 0 3px var(--rule);
  }
  .about__links {
    display: flex;
    gap: 0.6rem 1.25rem;
    flex-wrap: wrap;
    align-items: center;
    margin-top: 1.25rem;
  }
  @media (max-width: 800px) {
    .hero {
      grid-template-columns: 1fr;
      min-height: 0;
    }
  }
  @media (max-width: 640px) {
    .about {
      grid-template-columns: 1fr;
    }
    .about__photo {
      width: 112px;
      height: 112px;
    }
  }
</style>
